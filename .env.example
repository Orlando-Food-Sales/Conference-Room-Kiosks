DEMO_MODE=true
PORT=3000
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
ROOMS_FILE=./config/rooms.json
EVENT_REFRESH_SECONDS=60
TABLET_OFFLINE_SECONDS=120
# The installer replaces this with a random value when it starts with "replace-".
ADMIN_TOKEN=replace-with-a-random-64-character-value
PUBLIC_BASE_URL=

# Weather for the display theme and Snoopy's outfits (no key needed). Defaults to Glen Rock, NJ.
WEATHER_ENABLED=true
WEATHER_LATITUDE=40.9595
WEATHER_LONGITUDE=-74.1252
# auto = US National Weather Service (real airport station readings) inside the US, Open-Meteo elsewhere or as backup.
# Other values: nws, open-meteo.
WEATHER_SOURCE=auto
# The National Weather Service asks API users to identify themselves, for example an IT email address. Optional.
WEATHER_CONTACT=

# Birthdays and work anniversaries from a shared Microsoft 365 mailbox. Leave the mailbox empty to turn off.
BIRTHDAY_CALENDAR_MAILBOX=
# Optional: only read calendars whose name contains this text (for example: birth), or one exact calendar id.
BIRTHDAY_CALENDAR_NAME=
BIRTHDAY_CALENDAR_ID=
# first (default) or full
BIRTHDAY_NAME_STYLE=first
# Optional IANA time zone; defaults to the first room's time zone.
BIRTHDAY_TIME_ZONE=

# Office hours in each room's time zone. Outside them the display shows "Closed" instead of "Available".
# A meeting that is still in progress after hours shows "In use". Set OFFICE_HOURS=off to always show availability.
OFFICE_HOURS_START=08:00
OFFICE_HOURS_END=17:00
# Days of the week, 0 is Sunday: 1-5 is Monday to Friday.
OFFICE_DAYS=1-5

# The server checks each room calendar this often (seconds, 5 to 3600) and pushes any change to the tablets at once.
# Set to 0 to turn it off. No public web address is needed for this.
CHANGE_CHECK_SECONDS=15
# Only needed if you later add Microsoft Graph webhooks: notifications must carry this value.
GRAPH_CLIENT_STATE=

# Tablet offline alerts. A tablet that has not checked in for this many minutes during office hours
# raises an alert on the dashboard (and one "back online" message when it returns).
ALERT_AFTER_MINUTES=10
# Optional: also post alerts as {"text": "..."} to an https incoming webhook (Slack, Teams workflow, ...).
ALERT_WEBHOOK_URL=
