DEMO_MODE=true
PORT=3000
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# The day that secret expires, written YYYY-MM-DD (Entra > App registrations > Certificates & secrets). The server then
# sends an alert at 30, 14, 7, 3 and 1 days before, and when it has expired. Leave empty to turn the reminders off.
CLIENT_SECRET_EXPIRES=
# Optional, with HTTPS (INSTALL-UBUNTU.md 13b): the certificate file nginx uses, checked for automatic renewals that
# stopped working (alerts at 14, 7, 3 and 1 days left and when expired; normal renewals happen about 30 days before).
HTTPS_CERT_FILE=
# The day the login that renews that certificate expires (for example the Azure DNS login used by acme.sh), YYYY-MM-DD.
# Alerts at 30, 14, 7, 3 and 1 days before, and when it has expired.
CERT_RENEWAL_SECRET_EXPIRES=
ROOMS_FILE=./config/rooms.json
EVENT_REFRESH_SECONDS=60
TABLET_OFFLINE_SECONDS=120
# The installer replaces this with a random value when it starts with "replace-".
ADMIN_TOKEN=replace-with-a-random-64-character-value
PUBLIC_BASE_URL=

# Weather for the display theme and Snoopy's outfits (no key needed). Defaults to Glen Rock, NJ.
WEATHER_ENABLED=true
# Official National Weather Service warnings for the location above (US only): a red or amber banner on the tablets, and a
# Teams/webhook alert once for each Severe or Extreme warning. Set to false to turn them off.
WEATHER_ALERTS=true
WEATHER_LATITUDE=40.9595
WEATHER_LONGITUDE=-74.1252
# auto = US National Weather Service (real airport station readings) inside the US, Open-Meteo elsewhere or as backup.
# Other values: nws, open-meteo.
WEATHER_SOURCE=auto
# The National Weather Service asks API users to identify themselves, for example an IT email address. Optional.
WEATHER_CONTACT=

# Birthdays and work anniversaries from a shared Microsoft 365 mailbox. Leave the mailbox empty to turn off.
BIRTHDAY_CALENDAR_MAILBOX=
# Optional: only read calendars whose name contains this text (for example: birth), or one exact calendar id.
BIRTHDAY_CALENDAR_NAME=
BIRTHDAY_CALENDAR_ID=
# first (default) or full
BIRTHDAY_NAME_STYLE=first
# Optional IANA time zone; defaults to the first room's time zone.
BIRTHDAY_TIME_ZONE=

# Office hours in each room's time zone. Outside them the display shows "Closed" instead of "Available".
# A meeting that is still in progress after hours shows "In use". Set OFFICE_HOURS=off to always show availability.
OFFICE_HOURS_START=08:00
OFFICE_HOURS_END=17:00
# Days of the week, 0 is Sunday: 1-5 is Monday to Friday.
OFFICE_DAYS=1-5

# The server checks each room calendar this often (seconds, 5 to 3600) and pushes any change to the tablets at once.
# Set to 0 to turn it off. No public web address is needed for this.
CHANGE_CHECK_SECONDS=15
# Only needed if you later add Microsoft Graph webhooks: notifications must carry this value.
GRAPH_CLIENT_STATE=

# Tablet offline alerts. A tablet that has not checked in for this many minutes during office hours
# raises an alert on the dashboard (and one "back online" message when it returns).
ALERT_AFTER_MINUTES=10
# Optional: also post alerts as {"text": "..."} to an https incoming webhook (Slack, Teams workflow, ...).
ALERT_WEBHOOK_URL=

# Alerts from a named Teams bot to specific people (see INSTALL-UBUNTU.md, section 12b). Leave APP_ID, APP_SECRET and EMAILS empty to turn off.
# The bot can reuse the room display's own Entra app. That app then needs the Graph application permissions
# TeamsAppInstallation.ReadWriteSelfForUser.All and AppCatalog.Read.All, with admin consent.
# Application (client) ID of the bot's Entra app, e.g. 00000000-0000-0000-0000-000000000000
TEAMS_BOT_APP_ID=
# A client secret for that app (the same value as CLIENT_SECRET above if the app is reused).
TEAMS_BOT_APP_SECRET=
# Defaults to TENANT_ID above.
TEAMS_BOT_TENANT_ID=
# Sign-in names (usually email addresses) of up to 10 people, separated by commas, e.g. name1@example.com,name2@example.com
TEAMS_ALERT_EMAILS=
# Rarely needed: the Bot Connector address (default https://smba.trafficmanager.net/teams/).
TEAMS_BOT_SERVICE_URL=
# The app's own ID in the Teams admin center (Manage apps). Differs from TEAMS_BOT_APP_ID once the zip is uploaded, so set it.
TEAMS_BOT_CATALOG_ID=

# Optional: "Sign in with Microsoft" on the dashboard (INSTALL-UBUNTU.md, section 12c). Needs HTTPS (plain http only
# works for http://localhost). Off while these two are empty; ADMIN_TOKEN keeps working as the backup way in.
# Simplest: set DASHBOARD_SIGNIN_CLIENT_ID to CLIENT_ID above (the room display's own app) and leave the secret empty;
# CLIENT_SECRET is then used. With a separate sign-in app, set both.
DASHBOARD_SIGNIN_CLIENT_ID=
DASHBOARD_SIGNIN_CLIENT_SECRET=
# Defaults to TENANT_ID above.
DASHBOARD_SIGNIN_TENANT_ID=
# Defaults to PUBLIC_BASE_URL + /auth/callback, e.g. https://rooms.example.com/auth/callback (must match the app registration).
DASHBOARD_SIGNIN_REDIRECT_URI=
# Who may sign in, separated by commas. Defaults to the TEAMS_ALERT_EMAILS people.
DASHBOARD_ADMIN_EMAILS=
# How long a sign-in lasts, 1 to 24 hours (default 8). A server restart signs everyone out.
DASHBOARD_SESSION_HOURS=

# Optional door camera through Fully Kiosk Browser's Remote Admin (INSTALL-UBUNTU.md 12e): each room's tablet address
# (room=ip, comma separated, private addresses only; reserve them in DHCP) and the Remote Admin password set in Fully.
FULLY_CAMERA_HOSTS=
FULLY_REMOTE_PASSWORD=
# Fully's Remote Admin port (default 2323).
FULLY_REMOTE_PORT=
# Door intercom, noise meter and tablet location (INSTALL-UBUNTU.md 12f). They only work when the tablets use the https address.
# INTERCOM_ENABLED: the Call button on the kiosk tablets (default on). The microphone opens only after an administrator answers.
INTERCOM_ENABLED=
# How long a call rings before "Nobody answered", 10 to 120 seconds (default 45).
INTERCOM_RING_SECONDS=
# Longest a call may last, 1 to 60 minutes (default 10).
INTERCOM_MAX_MINUTES=
# NOISE_METER: tablets measure the room's noise level and send only a number (default on; off turns it off everywhere).
NOISE_METER=
# Levels in dBFS: quiet below NOISE_TALKING_DB (default -50), talking up to NOISE_LOUD_DB (default -35), loud above.
# NOISE_LOUD_DB must be higher than NOISE_TALKING_DB or the meter is turned off and the log says why. Tune from the dB numbers on the dashboard.
NOISE_TALKING_DB=
NOISE_LOUD_DB=
# LOCATION_REPORT: tablets report their position to the dashboard (default on).
LOCATION_REPORT=
# Where pushed and scheduled Snoopy outfits are saved (default: the app's data/ folder). Deploys never touch it.
DATA_DIR=
